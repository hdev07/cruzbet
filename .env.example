VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...

# Solo servidor/Vercel: nunca usar prefijo VITE_ con estas variables.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx
LIVE_SYNC_TOKEN=crea-un-token-aleatorio-largo
CRON_SECRET=crea-otro-token-aleatorio-largo
ADMIN_EMAIL=admin@example.com
ACTIVE_COMPETITION_SLUG=liga-mx-apertura-2026

# Web Push (recordatorios de quiniela). Generar par de llaves con:
#   npx web-push generate-vapid-keys
# La pública también va al cliente (VITE_). La privada SOLO en Vercel.
VITE_VAPID_PUBLIC_KEY=BExx...
VAPID_PUBLIC_KEY=BExx...
VAPID_PRIVATE_KEY=xxxx
VAPID_SUBJECT=mailto:admin@example.com
# Ventana del recordatorio en horas antes del primer kickoff (default 36)
# REMINDER_WINDOW_HOURS=36

# Opcional: URL fija de la tabla de menores en ligamx.net para este torneo.
# Si se omite, /api/sync-menores la descubre sola desde la home de Liga MX.
# LIGA_MX_MENORES_URL=https://www.ligamx.net/cancha/tablas/tablaMnrs/...

# URL pública del sitio (recomendado en Vercel)
VITE_SITE_URL=https://cruzbet.devifly.dev

# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://cruzbet.devifly.dev
#   Redirect URLs:
#     - http://localhost:5173/**
#     - https://cruzbet.devifly.dev/**
