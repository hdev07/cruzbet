VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...

# Sync automático en vivo (/api/sync-live) — sin cron de pago
# El frontend hace polling cada 60 s mientras haya alguien con la app abierta.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
LIVE_SYNC_TOKEN=genera-un-secreto-largo-aleatorio
# Opcional: polling en navegador sin login (el admin usa su sesión JWT)
# VITE_LIVE_SYNC_TOKEN=el-mismo-valor-que-LIVE_SYNC_TOKEN
# Cron externo gratis (cron-job.org)
CRON_SECRET=otro-secreto-para-cron-job-org
# Opcional: email admin si no tiene app_metadata.role en Supabase
ADMIN_EMAIL=tu-email@gmail.com

# URL pública del sitio (recomendado en Vercel). Sin esto, producción usa https://cruzbet.devifly.dev
VITE_SITE_URL=https://cruzbet.devifly.dev

# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://cruzbet.devifly.dev   ← NO dejar localhost:3000
#   Redirect URLs (añadir todas las que uses):
#     - http://localhost:5173/**
#     - http://localhost:3000/**
#     - https://cruzbet.devifly.dev/**
