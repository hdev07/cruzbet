{
  "functions": {
    "api/sync-live.ts": {
      "maxDuration": 60
    },
    "api/sync-menores.ts": {
      "maxDuration": 30
    },
    "api/sync-faltas.ts": {
      "maxDuration": 30
    },
    "api/backfill-match-stats.ts": {
      "maxDuration": 60
    },
    "api/send-reminders.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync-menores",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/sync-faltas",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
